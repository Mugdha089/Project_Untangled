# Local persistent storage and demo account. Replace the demo password before
# sharing a backend; newly registered accounts are stored independently.
UNTANGLE_DB_PATH=./data/untangle.sqlite3
UNTANGLE_DEMO_EMAIL=demo@untangle.local
UNTANGLE_DEMO_PASSWORD=replace-with-a-unique-local-demo-password
UNTANGLE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Optional backend-only AI adapters. Keep disabled until you add valid keys.
AI_PROVIDERS_ENABLED=false

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

XAI_API_KEY=replace-with-your-xai-api-key
XAI_MODEL=grok-4.7

HF_TOKEN=replace-with-your-huggingface-inference-token
HF_MODEL=Qwen/Qwen3-4B-Thinking-2507
